# ===========================================================================================
#  Atelier 3D Commerce: environment reference.  Copy to .env and edit.   cp .env.example .env
#  Required: DATABASE_URL, AUTH_SECRET.  Everything else has a working default.
# ===========================================================================================

# --- Database -----------------------------------------------------------------------------
# Docker stack (docker-compose.yml): postgres://atelier:atelier@localhost:5432/atelier
# PGlite quick start (npm run dev:db): postgres://postgres:postgres@127.0.0.1:5434/postgres
DATABASE_URL=postgres://atelier:atelier@localhost:5432/atelier
# Max pooled connections per server instance. Use 1 with the PGlite quick start (npm run dev:db).
# Real Postgres: keep (instances x pool) below the server's max_connections.
DATABASE_POOL_MAX=10
# Leave unset for real Postgres. Set to false ONLY with the in-memory PGlite server (npm run dev:db).
# DATABASE_FETCH_TYPES=false

# --- Auth ---------------------------------------------------------------------------------
# Signs session cookies and guest order links. >= 32 random chars; changing it logs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Session lifetime in days.
AUTH_SESSION_DAYS=7
# Rate limiting reads the client IP from X-Forwarded-For / X-Real-IP. Keep true behind a reverse
# proxy / CDN that sets them; set false if the app is exposed directly (all clients then share one bucket).
RATE_LIMIT_TRUST_PROXY=true

# --- Storage (3D models, textures, images, brand assets) ----------------------------------
# local = files in STORAGE_LOCAL_DIR, served by the app (dev / single node).
# s3    = any S3-compatible store: AWS S3, Cloudflare R2, MinIO, Backblaze B2.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads

# S3 / R2 / MinIO (only when STORAGE_DRIVER=s3). Blank values are treated as unset.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted stores; false for AWS S3 and R2.
S3_FORCE_PATH_STYLE=false
# Public base URL used to build asset links (your CDN / bucket domain, no trailing slash).
S3_PUBLIC_BASE_URL=
#
# --- local MinIO from docker-compose.yml: uncomment these and set STORAGE_DRIVER=s3 ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=atelier-assets
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=http://localhost:9000/atelier-assets
#
# --- Cloudflare R2 example ---
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=my-bucket
# S3_PUBLIC_BASE_URL=https://cdn.example.com      (R2 custom domain or r2.dev URL)
# Direct browser uploads need a CORS rule on the bucket allowing PUT from your site origin.

# --- Payments -----------------------------------------------------------------------------
# Provider id registered in server/adapters/payment (built in: mock). The store's
# store_settings.payment_provider decides which one is active at runtime.
PAYMENT_PROVIDER=mock

# --- Pending order expiry -----------------------------------------------------------------
# Unpaid "pending" orders older than this are cancelled and their stock / coupon use released.
# Trigger with `npm run orders:expire` or POST /api/internal/orders/expire (see TEMPLATE_SETUP.md).
ORDER_EXPIRY_MINUTES=30
# Bearer token for POST /api/internal/orders/expire. Unset = that endpoint is disabled (503). >= 16 chars.
CRON_SECRET=

# --- Seed (npm run db:seed) ---------------------------------------------------------------
# If SEED_ADMIN_PASSWORD is empty a random password is generated and printed once.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
