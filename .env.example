# --- Database ---
DATABASE_URL=postgres://atelier:atelier@localhost:5432/atelier

# --- Auth --- (generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
AUTH_SESSION_DAYS=7

# --- Storage: "local" | "s3" (s3 also covers Cloudflare R2, MinIO, Backblaze) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads
# Only for STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public CDN / bucket domain used to build asset URLs (e.g. https://cdn.example.com)
S3_PUBLIC_BASE_URL=

# --- Payments: "mock" | (register stripe / zarinpal adapters in Phase 2+) ---
PAYMENT_PROVIDER=mock

# --- Seed (used only by `npm run db:seed`; if the password is empty a random one is printed once) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
