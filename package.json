    "gsap": "^3.15.1",
    "jose": "^6.2.18",
    "next": "^16.4.6",
    "postcss": "^8.5.33",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "zod": "^4.6.7"
